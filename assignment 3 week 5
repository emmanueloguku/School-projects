float convertToCelsius(float fahrenheit) {
    float celsius = (fahrenheit - 32) * 5.0 / 9.0;
    return celsius;
}

int main() {
    float f, c;

    printf("Enter temperature in Fahrenheit: ");
    scanf("%f", &f);

    c = convertToCelsius(f);

    printf("%.2f F = %.2f C\n", f, c);
    
    return 0;
}
