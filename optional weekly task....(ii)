int main() {
    float principal, time, rate, amount, interest;

    printf("Enter principal amount: ");
    scanf("%f", &principal);

    printf("Enter time: ");
    scanf("%f", &time);

    printf("Enter rate: ");
    scanf("%f", &rate);

    amount = principal * pow((1 + rate / 100), time);
    interest = amount - principal;

    printf("Compound Interest is %.2f\n", interest);

    return 0;
