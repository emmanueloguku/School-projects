int main() {
    int units[10]; 
    int i;

    printf("Enter electricity units for 10 households:\n");
    for (i = 0; i < 10; i++) {
        printf("Household %d: ", i + 1);
        scanf("%d", &units[i]);
    }

    printf("\n--- Electricity Consumption Report ---\n");
    for (i = 0; i < 10; i++) {
        printf("Household %d = %d units\n", i + 1, units[i]);
    }

    return 0;
}
