int main() {
    int balance = 50000;
    int withdraw;

    printf("Your balance is %d\n", balance);

    printf("Enter withdrawal amount (0 to stop): ");
    scanf("%d", &withdraw);

    while (withdraw != 0) {
        
        if (withdraw > balance) {
            printf("Insufficient balance\n");
            break;
        }

        balance = balance - withdraw;
        printf("Remaining balance is %d\n", balance);

        printf("\nEnter withdrawal amount (0 to stop): ");
        scanf("%d", &withdraw);
    }

    printf("\nFinal balance is %d\n", balance);
    printf("Thank you");

    return 0;
}
