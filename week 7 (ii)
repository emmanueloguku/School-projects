struct Student {
    char name[50];
    char regNo[20];
    int marks;
};

int main() {
    struct Student stud;
    FILE *file;

    file = fopen("results.dat", "rb");
    if (file == NULL) {
        printf("Cannot open file\n");
        return 1;
    }

    printf("Student Results:\n");
    while (fread(&stud, sizeof(struct Student), 1, file)) {
        printf("Name: %s - Marks: %d\n", stud.name, stud.marks);
    }

    fclose(file);
    return 0;
}
