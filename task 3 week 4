int main() {
    int mark;
    char choice;

    do {
        do {
            printf("Enter student mark (0-100): ");
            scanf("%d", &mark);

            if (mark < 0 || mark > 100) {
                printf("Invalid mark! Enter again.\n");
            }
        } while (mark < 0 || mark > 100);

        printf("Mark is %d, Grade is ", mark);

        if (mark >= 80) {
            printf("A\n");
        } else if (mark >= 70) {
            printf("B\n");
        } else if (mark >= 60) {
            printf("C\n");
        } else if (mark >= 50) {
            printf("D\n");
        } else {
            printf("F\n");
        }

        printf("\nDo you want to enter another mark? (y/n): ");
        scanf(" %c", &choice);

    } while (choice == 'y' || choice == 'Y');

    printf("Thank you");

    return 0;
}
