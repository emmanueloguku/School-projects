int main() {
    float height;
    double balance;
    char phone[20];

    printf("Enter your height: ");
    scanf("%f", &height);

    printf("Enter your bank balance: ");
    scanf("%lf", &balance);

    printf("Enter your phone number: ");
    scanf("%19s", phone);

    printf("\nYour details are:\n");
    printf("Height is %.2f\n", height);
    printf("Bank balance is %.2lf\n", balance);
    printf("Phone number is %s\n", phone);

    return 0;
}
